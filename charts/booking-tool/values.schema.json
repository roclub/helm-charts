{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "description": "At most one application replica per database. A dedicated, empty CNPG database can coexist with EC2/RDS.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations"],
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "properties": {
            "eks.amazonaws.com/role-arn": {
              "type": "string",
              "pattern": "^arn:aws(-us-gov|-cn)?:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
            }
          }
        }
      },
      "if": {
        "properties": { "create": { "const": false } }
      },
      "then": {
        "properties": {
          "name": { "minLength": 1 },
          "annotations": { "maxProperties": 0 }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "server": false,
        "existingSecret": false,
        "database": false,
        "control_plane_app": {
          "$ref": "#/definitions/serviceAccountClient"
        },
        "controlplane_authz": {
          "$ref": "#/definitions/serviceAccountClient"
        },
        "deployment": {
          "type": "object",
          "properties": {
            "environment": { "type": "string" }
          }
        },
        "features": {
          "type": "object",
          "properties": {
            "operator_schedule_editing": { "type": "boolean" }
          }
        }
      },
      "description": "Inline ConfigMap configuration; server.port comes from service.httpPort and database comes from postgres. The existingSecret option is not supported."
    },
    "migration": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "connection": {
          "type": "object",
          "properties": {
            "port": { "const": 5432 },
            "database": { "$ref": "#/definitions/postgresIdentifier" },
            "sslMode": { "const": "require" }
          }
        },
        "users": {
          "type": "object",
          "properties": {
            "superuser": {
              "type": "object",
              "properties": {
                "name": { "const": "postgres" },
                "password": { "type": "string" }
              }
            },
            "runtime": { "$ref": "#/definitions/applicationRole" },
            "migration": { "$ref": "#/definitions/applicationRole" }
          }
        },
        "cluster": {
          "type": "object",
          "properties": {
            "instances": { "type": "integer", "minimum": 1 }
          }
        },
        "backup": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "objectStore": {
              "type": "object",
              "properties": {
                "destinationPath": { "type": "string", "pattern": "^s3://[^/]+.*$" },
                "credentials": {
                  "type": "object",
                  "properties": {
                    "accessKeyId": { "type": "string" },
                    "secretAccessKey": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "recovery": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "destinationPath": { "type": "string" },
            "serverName": { "type": "string" },
            "recoveryTarget": { "type": "object" },
            "credentials": {
              "type": "object",
              "properties": {
                "existingSecret": { "type": "string" },
                "accessKeyIdKey": { "type": "string", "minLength": 1 },
                "secretAccessKeyKey": { "type": "string", "minLength": 1 }
              }
            }
          },
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "properties": {
              "destinationPath": { "pattern": "^s3://[^/]+.*$" },
              "credentials": {
                "properties": { "existingSecret": { "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "postgresIdentifier": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "applicationRole": {
      "type": "object",
      "properties": {
        "name": {
          "allOf": [
            { "$ref": "#/definitions/postgresIdentifier" },
            { "not": { "const": "postgres" } }
          ]
        },
        "password": { "type": "string" }
      }
    },
    "serviceAccountClient": {
      "type": "object",
      "properties": {
        "service_account_key": { "type": "string" },
        "service_account_client_id": false,
        "service_account_client_secret": false
      }
    }
  }
}

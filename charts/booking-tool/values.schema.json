{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "description": "Use zero during EC2 coexistence or one after cutover.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations"],
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "properties": {
            "eks.amazonaws.com/role-arn": {
              "type": "string",
              "pattern": "^arn:aws(-us-gov|-cn)?:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
            }
          }
        }
      },
      "if": {
        "properties": { "create": { "const": false } }
      },
      "then": {
        "properties": {
          "name": { "minLength": 1 },
          "annotations": { "maxProperties": 0 }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "server": false,
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        }
      },
      "description": "The chart supplies server.port from service.httpPort."
    }
  }
}
